# Credenciales
config.php
.env
# CSV descargados por import.php
db/cache/
# App de escritorio
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
# Pokémon Añil: datos y sprites del juego (los genera scripts/anil.mjs). No van al repo: se copian a mano al servidor
public/anil/
# Hoja de iconos de objetos de Pokémon Showdown (la descarga import.php)
public/img/objetos.png
# Fotos de perfil que suben los usuarios (online): van en la copia de seguridad, no en el repo
public/fotos/
# Clave privada para firmar las actualizaciones del .exe (va en los secretos de GitHub, nunca en el repo)
claves/
*.key
# Android: lo genera Bubblewrap a partir de android/twa-manifest.json (y su clave de firma, nunca en el repo)
android/*
!android/twa-manifest.json
!android/assetlinks.json.ejemplo
!android/README.md
# Instaladores ya compilados (se suben a GitHub Releases, no al repo)
releases/
